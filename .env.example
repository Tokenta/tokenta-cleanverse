# Frontend — Privy App ID only (never put App Secret in Vite env)
VITE_PRIVY_APP_ID=your-privy-app-id

# Verification API (empty = Vite proxy to localhost:8787)
VITE_VERIFICATION_API=
VITE_USE_TERMINAL_API=true
VITE_API_DEV_TOKEN=
VITE_WALLET_ADDRESS=

# Base Sepolia testnet (must match server SETTLEMENT_*)
VITE_SETTLEMENT_CHAIN_ID=84532
VITE_SETTLEMENT_NETWORK=base-sepolia
VITE_SETTLEMENT_RPC_URL=https://sepolia.base.org
VITE_BLOCK_EXPLORER=https://sepolia.basescan.org

# --- Phase 1 on-chain escrow wallets ----------------------------------------
# Both addresses must be valid 0x-prefixed Base Sepolia addresses. Recommended
# pattern: deploy a Safe Multisig (https://app.safe.global) on Base Sepolia and
# use that address — never a personal MetaMask wallet for treasury.
#
# ESCROW receives the buyer's USDC when they "Lock Payment".
# TREASURY receives the 3% platform fee on each release.
VITE_ESCROW_WALLET=0x4463c9f60c27ebF9A966f8cD55d54e08114afb9E
VITE_TREASURY_WALLET=0x419fe9C2e707a4Ce3613c9945f9Dca03aeDD485d

# --- Hackathon Configuration --------------------------------------------------
# Switch application layout and compliance gating mode. (e.g. 'cleanverse')
VITE_TOKENTA_EDITION=cleanverse
