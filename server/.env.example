# Server-only — Privy App Secret (never expose to the browser)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# Terminal uses in-memory stores only — database persistence is disabled.
# DATABASE_URL is not required for normal operation.
PORT=8787
VERIFICATION_MOCK=true
VERIFICATION_BLACKLIST_FINGERPRINTS=
P2P_L1_ONLY_DEFAULT=true
LIVE_MONITOR_ENABLED=true
LIVE_MONITOR_INTERVAL_MS=60000
LIVE_MONITOR_TTL_P2P_MS=1800000
LIVE_MONITOR_TTL_DIRECT_MS=300000
LIVE_MONITOR_P2P_PROBE=true
LIVE_MONITOR_MAX_PROBES_PER_TICK=3
LIVE_MONITOR_PROBE_AGE_RATIO=0.85
L2_CADENCE_MS=21600000
USE_REDIS_QUEUE=false
USE_BULLMQ=false
REDIS_URL=redis://127.0.0.1:6379
# Base host only (no trailing /v1) — e.g. https://api.openai.com or your gateway root
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
DEV_CREDENTIAL_VAULT=true
DEV_CREDENTIAL_VAULT_ENCRYPTED=false
CREDENTIAL_VAULT_KEY=change-me-credential-vault-key
KMS_VAULT_ENABLED=false
REQUIRE_ESCROW_SIGNATURE=false
ESCROW_SIGNATURE_SECRET=change-me-escrow-secret
REQUIRE_API_AUTH=false
API_DEV_TOKEN=change-me-in-production
WALLET_AUTH=false
REQUIRE_BIND_SIGNATURE=false
BIND_SIGNATURE_SECRET=change-me-bind-secret
PROVIDER_MAX_CONCURRENT=4
PRIVY_JWT_MODE=false
PRIVY_JWT_VERIFY=false
PRIVY_JWT_DEV_SECRET=change-me-privy-dev-secret
PRIVY_JWKS_URL=
PRIVY_JWKS_CACHE_MS=300000
PROOF_ANCHOR_RPC_URL=https://sepolia.base.org
PROOF_ANCHOR_USE_CONTRACT=true
ZK_TEE_ATTEST_MOCK=false
KMS_VAULT_ENABLED=false
KMS_MASTER_KEY=
HASHICORP_VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
RUN_LIVE_OPENAI_SMOKE=false
USE_REGIONAL_QUEUES=false
WORKER_REGIONS=local,us-east-1,eu-west-1
LIVE_MONITOR_DIRECT_INTERVAL_MS=300000
LIVE_MONITOR_P2P_INTERVAL_MS=1800000
LIVE_MONITOR_STATE_TICK_MS=60000
LIVE_MONITOR_DISTRIBUTED_LOCK=true
PROOF_ANCHOR_AUTO_MOCK=false
PROOF_ANCHOR_CHAIN_ID=84532
PROOF_ANCHOR_CONTRACT_ADDRESS=
SETTLEMENT_NETWORK=base-sepolia
SETTLEMENT_CHAIN_ID=84532
SETTLEMENT_RPC_URL=https://sepolia.base.org
SETTLEMENT_CONTRACT_ADDRESS=
SETTLEMENT_DRY_RUN=true
SETTLEMENT_TX_MAX_RETRIES=2
SETTLEMENT_TX_RETRY_BACKOFF_MS=300
SETTLEMENT_GAS_BUMP_MULTIPLIER=1.25
SETTLEMENT_ANCHOR_RECONCILE_MS=60000
# On-chain settlement (Base Sepolia) — must match frontend VITE_* addresses
ESCROW_WALLET=0x4463c9f60c27ebF9A966f8cD55d54e08114afb9E
TREASURY_WALLET=0x419fe9C2e707a4Ce3613c9945f9Dca03aeDD485d
# Private key for the account that holds USDC in escrow (EOA matching ESCROW_WALLET, or hot wallet)
ESCROW_OPERATOR_PRIVATE_KEY=
# Optional: strict verify buyer fund tx on-chain before reconcile
REQUIRE_ONCHAIN_FUND_VERIFY=false
TREASURY_PRIVATE_KEY=
TERMINAL_SESSION_TTL_SEC=86400
# Optional IP-based timezone hint (browser timezone is preferred)
TERMINAL_TIMEZONE_IP_LOOKUP=false
TERMINAL_SESSION_REQUIRED=false
# Optional IP-based timezone hint (browser timezone is preferred)
TERMINAL_TIMEZONE_IP_LOOKUP=false
WORKER_REGION=local
REQUIRE_ESCROW_SIGNATURE=false
ESCROW_SIGNATURE_SECRET=change-me-escrow-secret

# --- Cleanverse Integration (Hackathon) ---------------------------------------
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_API_BASE_URL=
CLEANVERSE_ENV=sandbox
