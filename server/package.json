{
  "name": "@tokenta/terminal-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run src/api/verification-e2e.test.ts",
    "test:live-openai": "vitest run src/api/live-openai-smoke.test.ts",
    "test:redis-bullmq": "vitest run src/api/redis-bullmq-smoke.test.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:smoke": "tsx scripts/persistence-smoke.ts",
    "db:integration": "tsx scripts/db-integration-smoke.ts",
    "worker:region": "tsx scripts/worker-region.ts",
    "swagger:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@prisma/client": "^6.8.2",
    "bullmq": "^5.76.10",
    "dotenv": "^16.6.1",
    "hono": "^4.13.4",
    "ioredis": "^5.10.1",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "prisma": "^6.8.2",
    "solc": "^0.8.36",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
